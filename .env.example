# Gold PNG Backend - Environment Variables Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in the values with your actual configuration
# 3. NEVER commit .env to git (add to .gitignore)
# 4. Keep .env.example in git for reference

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# MongoDB Configuration
# ============================================
# Local development example:
# MONGO_URI=mongodb://localhost:27017/goldrates
# 
# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/goldrates
MONGO_URI=

# ============================================
# CORS & Frontend
# ============================================
# Frontend URL (for CORS configuration)
# Local: http://localhost:5173
# Vercel production: https://your-frontend.vercel.app
FRONTEND_URL=

# ============================================
# GitHub Actions / Cron Security
# ============================================
# IMPORTANT: Generate a random 32+ character secret
# Run this command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# This secret is used to:
# - Validate requests from GitHub Actions
# - Prevent unauthorized API calls to /api/cron/fetch-gold
# - Must match the GitHub Secret: CRON_SECRET
CRON_SECRET=

# ============================================
# Telegram Bot Configuration
# ============================================
# OPTIONAL: Leave empty if you don't want Telegram notifications
# 
# How to get TELEGRAM_BOT_TOKEN:
# 1. Message @BotFather on Telegram
# 2. Use /newbot command
# 3. Follow the prompts to create a bot
# 4. Copy the token (format: 1234567890:ABCDEFG...)
TELEGRAM_BOT_TOKEN=

# How to get TELEGRAM_CHAT_ID:
# 1. Message your bot
# 2. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 3. Find "chat": { "id": YOUR_CHAT_ID }
# 4. Copy the chat ID (format: 123456789)
TELEGRAM_CHAT_ID=

# ============================================
# Optional / Advanced
# ============================================
# CORS_ORIGIN=https://your-frontend.vercel.app
# LOG_LEVEL=debug
